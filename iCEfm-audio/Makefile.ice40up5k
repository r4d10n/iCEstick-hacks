# Makefile for iCE40-UP5K FPGA (e.g., UPduino, iCEBreaker)
# FM Audio Transmitter Project
#
# Usage:
#   make -f Makefile.ice40up5k        # Build bitstream
#   make -f Makefile.ice40up5k prog   # Program FPGA
#   make -f Makefile.ice40up5k clean  # Clean build files

# Project configuration
PROJECT = fm_audio_up5k
TOP_MODULE = fm_audio_top
PCF = pcf/ice40up5k.pcf

# FPGA target
DEVICE = up5k
PACKAGE = sg48

# Source files
RTL_DIR = rtl
SOURCES = $(RTL_DIR)/fm_audio_top.v \
          $(RTL_DIR)/uart_rx.v \
          $(RTL_DIR)/pll_wrapper.v \
          $(RTL_DIR)/fm_transmitter.v \
          $(RTL_DIR)/fifo.v

# Build tools
YOSYS = yosys
NEXTPNR = nextpnr-ice40
ICEPACK = icepack
ICETIME = icetime
ICEPROG = iceprog

# Build outputs
JSON = $(PROJECT).json
ASC = $(PROJECT).asc
BIN = $(PROJECT).bin
RPT = $(PROJECT).rpt

# Synthesis flags
YOSYS_FLAGS = -p 'synth_ice40 -top $(TOP_MODULE) -json $(JSON)'
YOSYS_DEFINES = -D FPGA_ICE40UP

# Place and route flags (using nextpnr for UP5K)
NEXTPNR_FLAGS = --$(DEVICE) --package $(PACKAGE) --pcf $(PCF) --json $(JSON) --asc $(ASC)

# Timing analysis flags
ICETIME_FLAGS = -d $(DEVICE) -P $(PACKAGE) -r $(RPT)

# Default target
all: $(BIN) $(RPT)

# Synthesis
$(JSON): $(SOURCES)
	@echo "Synthesizing design for iCE40-UP5K..."
	$(YOSYS) $(YOSYS_DEFINES) $(YOSYS_FLAGS) $(SOURCES)

# Place and route
$(ASC): $(JSON) $(PCF)
	@echo "Place and route (using nextpnr)..."
	$(NEXTPNR) $(NEXTPNR_FLAGS)

# Generate bitstream
$(BIN): $(ASC)
	@echo "Generating bitstream..."
	$(ICEPACK) $(ASC) $(BIN)

# Timing analysis
$(RPT): $(ASC)
	@echo "Running timing analysis..."
	$(ICETIME) $(ICETIME_FLAGS) $(ASC)

# Program FPGA
prog: $(BIN)
	@echo "Programming FPGA..."
	$(ICEPROG) $(BIN)

# Program with sudo (if needed)
sudo-prog: $(BIN)
	@echo "Programming FPGA (with sudo)..."
	sudo $(ICEPROG) $(BIN)

# Clean build files
clean:
	rm -f $(JSON) $(ASC) $(BIN) $(RPT)

# Show resource usage
show-usage: $(RPT)
	@echo "=== Resource Usage ==="
	@grep -A 10 "Device utilisation" $(RPT) || true

# Phony targets
.PHONY: all prog sudo-prog clean show-usage
