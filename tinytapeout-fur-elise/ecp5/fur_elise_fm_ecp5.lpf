# ECP5 Constraints for Fur Elise FM Transmitter
# Target: Vahya Mini ECP5 board
# Reference: https://github.com/r4d10n/vahya

#=============================================================================
# Clock and Reset
#=============================================================================
LOCATE COMP "clk" SITE "J14";      # 26 MHz clock input (Vahya Mini)
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 26 MHZ;

LOCATE COMP "rst_n" SITE "N6";     # Reset button (active low, Vahya Mini)
IOBUF PORT "rst_n" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;

#=============================================================================
# Enable Signal
#=============================================================================
LOCATE COMP "ena" SITE "R1";       # Enable (tied high or switch)
IOBUF PORT "ena" IO_TYPE=LVCMOS33 PULLMODE=UP;

#=============================================================================
# Input Signals (ui_in[7:0])
#=============================================================================
# Note: These inputs can be left unconnected for standalone operation
# If needed, connect to GPIO headers on Vahya Mini board
LOCATE COMP "ui_in[0]" SITE "F1";  # enable (optional)
IOBUF PORT "ui_in[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[1]" SITE "F2";  # loop (optional)
IOBUF PORT "ui_in[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[2]" SITE "E1";  # clk_2x_enable (optional)
IOBUF PORT "ui_in[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[3]" SITE "E2";  # pwm_in (optional)
IOBUF PORT "ui_in[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[4]" SITE "D1";  # reserved (not connected)
IOBUF PORT "ui_in[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[5]" SITE "D2";  # reserved (not connected)
IOBUF PORT "ui_in[5]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[6]" SITE "C1";  # reserved (not connected)
IOBUF PORT "ui_in[6]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "ui_in[7]" SITE "C2";  # reserved (not connected)
IOBUF PORT "ui_in[7]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

#=============================================================================
# Output Signals (uo_out[7:0])
#=============================================================================
# Primary outputs for Vahya Mini ECP5
LOCATE COMP "uo_out[0]" SITE "C10";  # fm_out (connect to antenna) - Vahya Mini GPIO
IOBUF PORT "uo_out[0]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[1]" SITE "D13";  # audio_out (connect to speaker/amp) - Vahya Mini GPIO
IOBUF PORT "uo_out[1]" IO_TYPE=LVCMOS33 DRIVE=4;

# Optional status outputs (not connected)
LOCATE COMP "uo_out[2]" SITE "B1";  # playing (LED indicator - optional)
IOBUF PORT "uo_out[2]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[3]" SITE "H3";  # melody_end (LED indicator - optional)
IOBUF PORT "uo_out[3]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[4]" SITE "H4";  # note_index[0] (debug LED - optional)
IOBUF PORT "uo_out[4]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[5]" SITE "J4";  # note_index[1] (debug LED - optional)
IOBUF PORT "uo_out[5]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[6]" SITE "G3";  # note_index[2] (debug LED - optional)
IOBUF PORT "uo_out[6]" IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "uo_out[7]" SITE "G4";  # note_index[3] (debug LED - optional)
IOBUF PORT "uo_out[7]" IO_TYPE=LVCMOS33 DRIVE=4;

#=============================================================================
# Bidirectional Signals (uio_in/out/oe[7:0])
#=============================================================================
# GPIO headers for debug (phase increment output) - optional, not connected
LOCATE COMP "uio_in[0]" SITE "E3";
LOCATE COMP "uio_out[0]" SITE "E3";
LOCATE COMP "uio_oe[0]" SITE "E3";
IOBUF PORT "uio_in[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[0]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[1]" SITE "D3";
LOCATE COMP "uio_out[1]" SITE "D3";
LOCATE COMP "uio_oe[1]" SITE "D3";
IOBUF PORT "uio_in[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[1]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[2]" SITE "C4";
LOCATE COMP "uio_out[2]" SITE "C4";
LOCATE COMP "uio_oe[2]" SITE "C4";
IOBUF PORT "uio_in[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[2]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[3]" SITE "B4";
LOCATE COMP "uio_out[3]" SITE "B4";
LOCATE COMP "uio_oe[3]" SITE "B4";
IOBUF PORT "uio_in[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[3]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[4]" SITE "A2";
LOCATE COMP "uio_out[4]" SITE "A2";
LOCATE COMP "uio_oe[4]" SITE "A2";
IOBUF PORT "uio_in[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[4]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[4]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[5]" SITE "A3";
LOCATE COMP "uio_out[5]" SITE "A3";
LOCATE COMP "uio_oe[5]" SITE "A3";
IOBUF PORT "uio_in[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[5]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[5]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[6]" SITE "A4";
LOCATE COMP "uio_out[6]" SITE "A4";
LOCATE COMP "uio_oe[6]" SITE "A4";
IOBUF PORT "uio_in[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[6]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[6]" IO_TYPE=LVCMOS33;

LOCATE COMP "uio_in[7]" SITE "A5";
LOCATE COMP "uio_out[7]" SITE "A5";
LOCATE COMP "uio_oe[7]" SITE "A5";
IOBUF PORT "uio_in[7]" IO_TYPE=LVCMOS33;
IOBUF PORT "uio_out[7]" IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "uio_oe[7]" IO_TYPE=LVCMOS33;

#=============================================================================
# Notes:
# - This configuration is for Vahya Mini ECP5 board
# - Primary outputs: fm_out at C10, audio_out at D13
# - Clock: 26 MHz at J14 (Vahya Mini standard)
# - Reset: N6 (Vahya Mini reset button)
# - Most inputs/outputs can remain unconnected for standalone FM transmitter operation
# - Reference: https://github.com/r4d10n/vahya
#=============================================================================
