+        .ui_in   (ui_in),
+        .uo_out  (uo_out),
+        .uio_in  (uio_in),
+        .uio_out (uio_out),
+        .uio_oe  (uio_oe),
+        .ena     (ena),
+        .clk     (clk),
+        .rst_n   (rst_n)
+    );
+
+    //=========================================================================
+    // Clock Generation
+    //=========================================================================
+    initial clk = 0;
+    always #(CLK_PERIOD_NS/2) clk = ~clk;
+
+    //=========================================================================
+    // Signal Aliases for Readability
+    //=========================================================================
+    wire fm_out     = uo_out[0];
+    wire audio_out  = uo_out[1];
